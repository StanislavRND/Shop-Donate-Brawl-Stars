# Copy this file to .env and fill in real values.

# Application
APP_NAME="Vanta Shop API"
APP_VERSION="0.1.0"
DEBUG=true

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=shop_donate

# JWT / OAuth2
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Email verification
EMAIL_VERIFICATION_CODE_EXPIRE_MINUTES=10

# SMTP
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Vanta Shop
SMTP_STARTTLS=true

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Auth cookies (for production: COOKIES_SECURE=true; for cross-domain frontend set COOKIES_SAMESITE=none)
COOKIES_SECURE=false
COOKIES_SAMESITE=lax
COOKIES_DOMAIN=
